# Backend API base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000/api

# Maximum number of photos allowed in event creation
VITE_MAX_EVENT_PHOTOS=20

# Cloudflare Turnstile site key for the hackathon registration form (public, safe to commit).
# The production key only validates on ieee.nu / www.ieee.nu. For localhost and Vercel previews use
# Cloudflare's always-pass test key 1x00000000000000000000AA, or leave this empty to hide the widget
# (the API must then not require a token).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFL51pDE8f8XQPur
