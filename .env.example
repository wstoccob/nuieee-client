# Backend API base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000/api

# Maximum number of photos allowed in event creation
VITE_MAX_EVENT_PHOTOS=20

# Cloudflare Turnstile site key for the hackathon registration form.
# Leave empty to skip the widget (the API must then not require a token).
VITE_TURNSTILE_SITE_KEY=
